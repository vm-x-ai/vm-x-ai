{
  "name": "api",
  "version": "1.3.0",
  "private": true,
  "nx": {
    "release": {
      "docker": {
        "repositoryName": "vmxai/api"
      }
    },
    "targets": {
      "test": {
        "defaultConfiguration": "unit"
      },
      "docker:publish:latest": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "docker tag packages-api docker.io/vmxai/api:latest",
            "docker push docker.io/vmxai/api:latest"
          ],
          "parallel": false,
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "docker:build"
        ]
      },
      "tailwind:build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpx @tailwindcss/cli -i ./views/global.css -o ./assets/main.css",
          "cwd": "{projectRoot}"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "nest build",
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ]
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/packages/api/dist/package.json",
          "{workspaceRoot}/packages/api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/packages/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "emit-pnpm-workspace-yaml": {
        "dependsOn": [
          "prune-lockfile"
        ],
        "cache": true,
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/packages/api/dist/pnpm-workspace.yaml"
        ],
        "inputs": [
          "{projectRoot}/package.json",
          "{projectRoot}/scripts/emit-prune-workspace-yaml.mjs"
        ],
        "options": {
          "command": "node scripts/emit-prune-workspace-yaml.mjs",
          "cwd": "{projectRoot}"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules",
          "emit-pnpm-workspace-yaml"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "nest start --watch",
          "cwd": "{projectRoot}"
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      },
      "codegen": {
        "executor": "nx:run-commands",
        "options": {
          "command": "kysely-codegen",
          "cwd": "{projectRoot}"
        }
      },
      "migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "ts-node -P tsconfig.app.json src/migrate.ts",
          "cwd": "{projectRoot}"
        }
      },
      "migrate:reset": {
        "executor": "nx:run-commands",
        "options": {
          "command": "ts-node -P tsconfig.app.json src/migrate.ts --reset",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@aws-crypto/client-node": "^4.2.1",
    "@aws-sdk/client-bedrock-runtime": "^3.1045.0",
    "@aws-sdk/credential-providers": "^3.1045.0",
    "@fastify/express": "^4.0.2",
    "@fastify/static": "^8.3.0",
    "@fastify/view": "11.1.1",
    "@google/genai": "^2.0.1",
    "@keyv/redis": "^5.1.3",
    "@nest-lab/or-guard": "^2.6.0",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.7",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.2",
    "@opentelemetry/context-async-hooks": "^2.2.0",
    "@opentelemetry/core": "^2.2.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/propagator-b3": "^2.2.0",
    "@opentelemetry/propagator-jaeger": "^2.2.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@scalar/nestjs-api-reference": "^1.1.14",
    "@smithy/types": "^4.9.0",
    "@vm-x-ai/shared-ai-provider": "workspace:*",
    "argon2": "^0.44.0",
    "axios": "^1.13.2",
    "axios-retry": "^4.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "ejs": "^3.1.10",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2",
    "joi": "^18.0.1",
    "js-tiktoken": "^1.0.21",
    "json-schema": "^0.4.0",
    "kysely": "^0.28.8",
    "kysely-codegen": "0.19.0",
    "libsodium-wrappers": "^0.7.15",
    "lodash": "4.17.21",
    "lodash.get": "^4.4.2",
    "lodash.merge": "^4.6.2",
    "nanoid": "^5.1.6",
    "nestjs-otel": "^7.0.1",
    "nestjs-pino": "^4.4.1",
    "node-jose": "^2.2.0",
    "oidc-provider": "^9.5.2",
    "openai": "^6.37.0",
    "openid-client": "^6.8.1",
    "passport-http-bearer": "^1.0.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.2",
    "string-dedent": "^3.0.2",
    "ts-enum-util": "^4.1.0",
    "uuid": "^13.0.0",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.4",
    "@types/json-schema": "^7.0.15",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/node-jose": "^1.1.13",
    "@types/oidc-provider": "^9.5.0",
    "@types/passport-http-bearer": "^1.0.42",
    "@types/yargs": "^17.0.34",
    "kysely-codegen": "^0.19.0",
    "tailwindcss": "4.1.17",
    "unplugin-swc": "^1.5.9",
    "vite": "^7.1.12",
    "vitest": "4.0.9",
    "yargs": "^18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "@nestjs/core",
      "@parcel/watcher",
      "@scarf/scarf",
      "@swc/core",
      "argon2",
      "esbuild",
      "protobufjs"
    ]
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38"
}
